{
  "name": "autopsy",
  "version": "0.23.1",
  "private": true,
  "description": "Postmortem analysis for your tabs - find what to close",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:screenshots": "tsc && vite build --mode screenshots --outDir dist-screenshots",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build:screenshots && node scripts/capture-screenshots.js",
    "package": "npm run build && node scripts/package.js",
    "promo": "node scripts/generate-promo.js",
    "cws": "node scripts/cws.js"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
